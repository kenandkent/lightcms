# LightCMS test environment template (Task 0).
#
# Copy to `.env.test` (gitignored — never commit secrets or local URIs):
#   cp .env.test.example .env.test
#
# `internal/testutil/testutil.go` loads `.env.test` by walking up from the
# test working directory (up to 6 levels) and reads MONGODB_URI / DATABASE_NAME.
#
# SAFETY GUARD (verified present in internal/testutil/testutil.go,
# MustConnectTestDB): the database name MUST contain "test" (case-insensitive).
# Any other name aborts the test binary with:
#   REFUSING to run tests — database name ... does not contain 'test'.
# This prevents wiping a production database via CleanupCollections.

# Single-node replica set from docker-compose.test.yml.
# `replicaSet=rs0` enables transactions; `directConnection=true` is required
# for a single-node RS reached via the localhost port mapping.
MONGODB_URI=mongodb://127.0.0.1:27017/lightcms-test?replicaSet=rs0&directConnection=true

# Isolated test database. MUST contain "test" (see guard above).
DATABASE_NAME=lightcms-test
