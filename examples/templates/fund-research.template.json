{
  "slug": "fund-research",
  "name": "基金研报模板",
  "category": "金融研究",
  "description": "适用于基金分析、资产配置和投资研究。米白与森林绿配色、衬线标题及机构研报版式，支持中英双语和社交分享。",
  "fields": [
    {
      "name": "headline",
      "label": "英文标题",
      "type": "text",
      "required": true
    },
    {
      "name": "summary",
      "label": "英文摘要",
      "type": "textarea",
      "required": true
    },
    {
      "name": "body",
      "label": "英文正文（Markdown）",
      "type": "markdown",
      "required": true
    },
    {
      "name": "author",
      "label": "作者",
      "type": "text",
      "required": true
    },
    {
      "name": "category",
      "label": "文章分类",
      "type": "text",
      "required": true
    },
    {
      "name": "headline_zh",
      "label": "中文标题",
      "type": "text",
      "required": false
    },
    {
      "name": "summary_zh",
      "label": "中文摘要",
      "type": "textarea",
      "required": false
    },
    {
      "name": "body_zh",
      "label": "中文正文（Markdown）",
      "type": "markdown",
      "required": false
    },
    {
      "name": "category_zh",
      "label": "中文文章分类",
      "type": "text",
      "required": false
    },
    {
      "name": "publisher_name",
      "label": "发布者名称",
      "type": "text",
      "required": false
    },
    {
      "name": "publisher_name_zh",
      "label": "中文发布者名称",
      "type": "text",
      "required": false
    },
    {
      "name": "share_image_url",
      "label": "社交预览图地址（1200×630）",
      "type": "url",
      "required": false,
      "validation": {
        "allowed_protocols": [
          "https"
        ]
      }
    },
    {
      "name": "share_image_alt",
      "label": "社交预览图说明",
      "type": "text",
      "required": false
    },
    {
      "name": "favicon_url",
      "label": "网站图标地址",
      "type": "url",
      "required": false,
      "validation": {
        "allowed_protocols": [
          "https"
