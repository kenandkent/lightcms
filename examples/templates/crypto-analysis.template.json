{
  "slug": "crypto-analysis",
  "name": "加密货币分析模板",
  "category": "加密研究",
  "description": "适用于加密货币市场、行情结构与链上数据分析。内嵌响应式样式、500毫秒加载效果、中英界面及社交分享元信息；正文采用富文本格式。",
  "fields": [
    {
      "name": "headline",
      "label": "标题",
      "type": "text",
      "required": true
    },
    {
      "name": "summary",
      "label": "摘要",
      "type": "textarea",
      "required": true
    },
    {
      "name": "body",
      "label": "正文（富文本）",
      "type": "richtext",
      "required": true
    },
    {
      "name": "author",
      "label": "作者",
      "type": "text",
      "required": true
    },
    {
      "name": "category",
      "label": "文章分类",
      "type": "text",
      "required": true
    },
    {
      "name": "share_image_url",
      "label": "社交预览图地址（1200×630）",
      "type": "url",
      "required": false,
      "validation": {
        "allowed_protocols": [
          "https"
        ]
      }
    },
    {
      "name": "share_image_alt",
      "label": "社交预览图说明",
      "type": "text",
      "required": false
    },
    {
      "name": "favicon_url",
      "label": "网站图标地址",
      "type": "url",
      "required": false,
      "validation": {
        "allowed_protocols": [
          "https"
        ]
      }
    }
  ],
  "html_layout": "<!doctype html>\n<html lang=\"en\" prefix=\"og: https://ogp.me/ns# article: https://ogp.me/ns/article#\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#101c29\">\n  <title>{{.headline}} | Chain Lens</title>\n  <meta name=\"description\" content=\"{{.summary}}\">\n  <meta name=\"author\" content=\"{{.author}}\">\n  {{if .public_url}}<link rel=\"canonical\" href=\"{{.public_url}}\">\n  <meta property=\"og:url\" content=\"{{.public_url}}\">{{end}}\n  <meta property=\"og:type\" content=\"article\">\n  <meta property=\"og:site_name\" content=\"Chain Lens\">\n  <meta property=\"og:locale\" content=\"en_US\">\n  <meta property=\"og:title\" content=\"{{.headline}}\">\n  <meta property=\"og:description\" content=\"{{.summary}}\">\n  <meta property=\"article:section\" content=\"{{.category}}\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"{{.headline}}\">\n  <meta name=\"twitter:description\" content=\"{{.summary}}\">\n  {{if .share_image_url}}<meta property=\"og:image\" content=\"{{.share_image_url}}\">\n  <meta property=\"og:image:width\" content=\"1200\">\n  <meta property=\"og:image:height\" content=\"630\">\n  <meta property=\"og:image:alt\" content=\"{{if .share_image_alt}}{{.share_image_alt}}{{else}}Chain Lens crypto market analysis{{end}}\">\n  <meta name=\"twitter:image\" content=\"{{.share_image_url}}\">\n  <meta name=\"twitter:image:alt\" content=\"{{if .share_image_alt}}{{.share_image_alt}}{{else}}Chain Lens crypto market analysis{{end}}\">{{end}}\n  <link rel=\"icon\" href=\"{{if .favicon_url}}{{.favicon_url}}{{else}}/static/images/chain-lens-icon.svg{{end}}\">\n  <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/static/images/chain-lens-touch.png\">\n  <style>\n    :root { color-scheme:dark; --page:#101c29; --surface:#172635; --ink:#eef3f5; --body:#c8d5dc; --muted:#9bb0bd; --line:#304555; --teal:#7acdc0; --gold:#e0bb79; --loading-duration:500ms; }\n    *,*::before,*::after { box-sizing:border-box; }\n    html { scroll-behavior:smooth; }\n    body { margin:0; background:var(--page); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif; -webkit-font-smoothing:antialiased; }\n    a { color:inherit; }\n    button { font:inherit; }\n    :focus-visible { outline:2px solid var(--gold); outline-offset:4px; }\n    .page-content { visibility:hidden; animation:reveal-content 0s linear var(--loading-duration) forwards; }\n    .loading-screen { position:fixed; inset:0; z-index:50; display:grid; place-items:center; background:var(--page); animation:hide-loading 0s linear var(--loading-duration) forwards; }\n    .loading-inner { display:grid; justify-items:center; gap:16px; }\n    .loading-mark { font-size:34px; color:var(--teal); }\n    .loading-label { color:var(--muted); font-size:14px; }\n    .loading-track { display:block; width:112px; height:2px; overflow:hidden; background:var(--line); }\n    .loading-line { display:block; width:44px; height:100%; background:var(--teal); animation:loading-sweep 500ms ease-in-out infinite alternate; }\n    @keyframes reveal-content { to { visibility:visible; } }\n    @keyframes hide-loading { to { visibility:hidden; } }\n    @keyframes loading-sweep { to { transform:translateX(68px); } }\n    .skip-link { position:absolute; top:-60px; left:16px; z-index:20; padding:12px 16px; background:var(--gold); color:var(--page); }\n    .skip-link:focus { top:16px; }\n    .reading-progress { position:fixed; inset:0 auto auto 0; z-index:30; width:0; height:3px; background:var(--teal); pointer-events:none; }\n    .shell { width:min(100% - 40px,1160px); margin-inline:auto; }\n    .site-header { border-bottom:1px solid var(--line); }\n    .header-inner { min-height:76px; display:flex; align-items:center; justify-content:space-between; gap:24px; }\n    .brand { display:flex; align-items:center; gap:12px; font-size:18px; font-weight:700; }\n    .brand-mark { color:var(--teal); font-size:28px; }\n    .header-note { color:var(--muted); font-size:13px; }\n    .article-header { padding-block:clamp(56px,8vw,108px) 52px; }\n    .topic { display:inline-block; margin-bottom:24px; padding-bottom:9px; border-bottom:2px solid var(--teal); color:var(--teal); font-size:14px; }\n    h1 { max-width:22ch; margin:0; font-size:clamp(34px,5.4vw,68px); font-weight:700; letter-spacing:-.045em; line-height:1.15; overflow-wrap:anywhere; }\n    .summary { max-width:62ch; margin:28px 0 0; color:var(--body); font-size:clamp(17px,1.6vw,20px); line-height:1.75; }\n    .article-meta { display:flex; flex-wrap:wrap; gap:8px 20px; margin-top:32px; color:var(--muted); font-size:14px; font-variant-numeric:tabular-nums; }\n    .article-meta strong { color:var(--ink); font-weight:600; }\n    .article-grid { display:grid; grid-template-columns:minmax(0,72ch) minmax(190px,1fr); gap:clamp(40px,7vw,100px); align-items:start; border-top:1px solid var(--line); padding-block:48px 96px; }\n    .story { min-width:0; color:var(--body); font-size:17px; line-height:1.9; overflow-wrap:anywhere; }\n    .story > :first-child { margin-top:0; }\n    .story h2,.story h3 { color:var(--ink); line-height:1.35; letter-spacing:-.025em; }\n    .story h2 { margin:2.4em 0 .7em; font-size:clamp(24px,2.6vw,32px); }\n    .story h3 { margin:2em 0 .6em; font-size:21px; }\n    .story p,.story ul,.story ol,.story blockquote { margin-block:0 1.35em; }\n    .story a { color:var(--teal); text-underline-offset:4px; }\n    .story strong { color:var(--ink); }\n    .story blockquote { margin-inline:0; border-left:3px solid var(--teal); padding-left:22px; color:var(--ink); }\n    .story img { display:block; max-width:100%; height:auto; margin-block:32px; border-radius:5px; }\n    .story pre { max-width:100%; overflow-x:auto; padding:20px; background:var(--surface); font-size:14px; }\n    .story table { display:block; max-width:100%; overflow-x:auto; border-collapse:collapse; font-size:14px; line-height:1.6; margin-block:24px 32px; }\n    .story th,.story td { min-width:130px; border-bottom:1px solid var(--line); padding:12px 18px 12px 0; text-align:left; vertical-align:top; }\n    .story th { color:var(--ink); }\n    .side-note { position:sticky; top:32px; border-top:2px solid var(--gold); padding-top:22px; }\n    .side-note h2 { margin:0 0 14px; color:var(--gold); font-size:16px; }\n    .side-note p { margin:0; color:var(--muted); font-size:14px; line-height:1.8; }\n    .side-note .divider { height:1px; margin-block:22px; background:var(--line); }\n    .article-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:48px; }\n    .action-button { min-height:44px; padding:10px 16px; border:1px solid var(--line); border-radius:5px; background:var(--surface); color:var(--ink); cursor:pointer; }\n    .action-button:hover { border-color:var(--teal); }\n    .site-footer { border-top:1px solid var(--line); }\n    .footer-inner { display:flex; flex-wrap:wrap; justify-content:space-between; gap:16px; padding-block:28px 40px; color:var(--muted); font-size:13px; line-height:1.7; }\n    .footer-inner p { margin:0; }\n    @media(max-width:800px) { .article-grid { grid-template-columns:minmax(0,1fr); gap:48px; } .side-note { position:static; } }\n    @media(max-width:600px) { .shell { width:calc(100% - 32px); } .header-inner { min-height:64px; } .header-note { display:none; } .article-header { padding-block:52px 40px; } h1 { max-width:none; } .article-grid { padding-block:36px 64px; } .story { font-size:16px; line-height:1.85; } }\n    @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } .loading-line { animation:none; width:100%; } }\n    @media print { :root { color-scheme:light; } body { background:white; color:#1b2630; } .loading-screen,.site-header,.side-note,.article-actions,.reading-progress { display:none; } .page-content { visibility:visible; animation:none; } .article-grid { display:block; } .story,.summary { color:#1b2630; } }\n  </style>\n</head>\n<body>\n  <div class=\"loading-screen\" role=\"status\" aria-live=\"polite\"><div class=\"loading-inner\"><span class=\"loading-mark\" aria-hidden=\"true\">◇</span><span class=\"loading-label\" data-i18n=\"loading\">Loading</span><span class=\"loading-track\" aria-hidden=\"true\"><span class=\"loading-line\"></span></span></div></div>\n  <div class=\"page-content\">\n    <a class=\"skip-link\" href=\"#article-content\" data-i18n=\"skip_link\">Skip to article</a>\n    <div class=\"reading-progress\" id=\"reading-progress\" aria-hidden=\"true\"></div>\n    <header class=\"site-header\"><div class=\"shell header-inner\"><div class=\"brand\"><span class=\"brand-mark\" aria-hidden=\"true\">◇</span><span data-i18n=\"site_name\">Chain Lens</span></div><span class=\"header-note\" data-i18n=\"header_note\">Crypto market analysis · Independent perspective</span></div></header>\n    <main><article class=\"shell\">\n      <header class=\"article-header\"><span class=\"topic\">{{.category}}</span><h1>{{.headline}}</h1><p class=\"summary\">{{.summary}}</p><div class=\"article-meta\"><span><span data-i18n=\"author_label\">By</span> <strong>{{.author}}</strong></span><span><span data-i18n=\"published_label\">Published</span> <time>{{.published_at}}</time></span></div></header>\n      <div class=\"article-grid\"><div><div class=\"story\" id=\"article-content\">{{.body}}</div><div class=\"article-actions\"><button class=\"action-button\" id=\"copy-link\" type=\"button\" data-i18n=\"copy_link\">Copy article link</button><button class=\"action-button\" id=\"back-to-top\" type=\"button\" data-i18n=\"back_to_top\">Back to top</button></div></div>\n        <aside class=\"side-note\"><h2 data-i18n=\"reading_tip\">Reading note</h2><p data-i18n=\"risk_note\">This article discusses market information and analytical frameworks, not investment advice. Crypto assets are volatile; make decisions based on your own risk tolerance.</p><div class=\"divider\"></div><p data-i18n=\"method_note\">Our analysis examines sources, market structure, and risk. Short-term price forecasts are no substitute for verified facts.</p></aside>\n      </div>\n    </article></main>\n    <footer class=\"site-footer\"><div class=\"shell footer-inner\"><p data-i18n=\"footer_about\">Chain Lens · Crypto markets and digital assets</p><p data-i18n=\"footer_disclaimer\">For information only. Not investment advice.</p></div></footer>\n  </div>\n  <script>\n    (function () {\n      var preferredLanguage = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';\n      var language = /^zh(?:-|$)/i.test(preferredLanguage) ? 'zh-CN' : 'en';\n      var translations = {\n        en: { loading:'Loading', site_name:'Chain Lens', skip_link:'Skip to article', header_note:'Crypto market analysis · Independent perspective', author_label:'By', published_label:'Published', copy_link:'Copy article link', back_to_top:'Back to top', reading_tip:'Reading note', risk_note:'This article discusses market information and analytical frameworks, not investment advice. Crypto assets are volatile; make decisions based on your own risk tolerance.', method_note:'Our analysis examines sources, market structure, and risk. Short-term price forecasts are no substitute for verified facts.', footer_about:'Chain Lens · Crypto markets and digital assets', footer_disclaimer:'For information only. Not investment advice.', copied:'Link copied', copy_failed:'Could not copy. Use the address bar.' },\n        zh: { loading:'加载中', site_name:'链上观察', skip_link:'跳转到正文', header_note:'加密市场分析 · 保持独立判断', author_label:'作者', published_label:'发布时间', copy_link:'复制文章链接', back_to_top:'返回顶部', reading_tip:'阅读提示', risk_note:'本文讨论市场信息与分析框架，并非投资建议。加密资产波动较大，请结合自身风险承受能力独立判断。', method_note:'分析关注信息来源、市场结构与风险边界，不以短期价格预测代替事实核查。', footer_about:'链上观察 · 聚焦加密市场与数字资产', footer_disclaimer:'内容仅供参考，不构成投资建议。', copied:'链接已复制', copy_failed:'复制失败，请使用地址栏' }\n      };\n      var messages = language === 'zh-CN' ? translations.zh : translations.en;\n      document.documentElement.lang = language;\n      document.title = document.title.replace(/\\s\\|\\s[^|]*$/, ' | ' + messages.site_name);\n      document.querySelectorAll('[data-i18n]').forEach(function (element) { element.textContent = messages[element.getAttribute('data-i18n')]; });\n      var progress = document.getElementById('reading-progress');\n      var copyButton = document.getElementById('copy-link');\n      var resetLabelTimer;\n      function updateProgress() { var range = document.documentElement.scrollHeight - window.innerHeight; progress.style.width = Math.max(0,Math.min(100,range > 0 ? window.scrollY / range * 100 : 100)) + '%'; }\n      copyButton.addEventListener('click',async function () {\n        try { await navigator.clipboard.writeText(window.location.href); copyButton.textContent = messages.copied; }\n        catch (error) { copyButton.textContent = messages.copy_failed; }\n        window.clearTimeout(resetLabelTimer);\n        resetLabelTimer = window.setTimeout(function () { copyButton.textContent = messages.copy_link; },3000);\n      });\n      document.getElementById('back-to-top').addEventListener('click',function () { window.scrollTo({top:0,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'}); });\n      window.addEventListener('scroll',updateProgress,{passive:true});\n      window.addEventListener('resize',updateProgress);\n      updateProgress();\n    }());\n  </script>\n</body>\n</html>\n"
}
