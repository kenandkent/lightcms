# Binaries (root-anchored: bare names would exclude any same-named directory,
# e.g. cmd/server/ — do NOT un-anchor these)
/lightcms
bin/
/server

# Uploads (user content)
static/uploads/*
!static/uploads/.gitkeep

# Generated sitemap (site-specific, not part of software; regenerated on demand)
static/sitemap.xml
internal/handlers/static/sitemap.xml

# Generated theme CSS (regenerated from DB settings on every boot and by
# package tests using their own CWD — never track, or every run dirties the tree)
static/css/theme-vars.css
internal/handlers/static/css/theme-vars.css

# Generated content (site-specific, not part of software)
content/

# Config files (contain secrets)
config.dev.json
config.prod.json
.env
.env.local
.env.test

# Registry tokens (contain auth secrets)
.mcpregistry_*

# Deploy script (local only, not for distribution)
deploy.sh

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# MCPB bundles (platform-specific, distributed via GitHub Releases)
*.mcpb
bundle/

# GoReleaser dist
dist/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
VIBECTL.md
---
# Python bytecode (generator side-effects)
__pycache__/
*.pyc
